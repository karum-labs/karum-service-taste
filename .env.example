# karum-service-taste environment variables.
#
# Every variable the taste service reads, with its default. All values have
# working defaults, so the service boots in fixture mode with no .env file.
#
# The authoritative cross-repo list lives in the infra repo; this file mirrors
# the variables that affect THIS process only.

# --- Service identity ------------------------------------------------------
# gRPC port the taste service listens on.
TASTE_PORT=8081
# Operational mode: live, fixture, or degraded. Reported on /health.
TASTE_MODE=fixture
# Human-readable service name used in logs and health payloads.
TASTE_SERVICE_NAME=service-taste

# --- Qloo ------------------------------------------------------------------
# Qloo API key. Injected via secret manager in production; NEVER committed.
# The hackathon key only works against the hackathon base URL below.
TASTE_QLOO_API_KEY=
# Qloo base URL for the hackathon key.
TASTE_QLOO_BASE_URL=https://hackathon.api.qloo.com
# Per-request timeout for outbound Qloo calls, in seconds.
TASTE_QLOO_TIMEOUT_SECONDS=10.0
# Maximum retries with backoff for retriable Qloo failures.
TASTE_QLOO_MAX_RETRIES=3
# Per-second request budget; the hackathon key publishes 5 (X-Second-RateLimit-Limit).
TASTE_QLOO_RPS=5.0
# Base seconds for exponential retry backoff (0.5, 1, 2, ...).
TASTE_QLOO_BACKOFF_BASE_SECONDS=0.5

# --- Fixtures ---------------------------------------------------------------
# Redacted fixture pack root for fixture mode; relative paths resolve against
# this repository's root. The pack ships in the karum-infra repo (PLAN.md §4).
TASTE_FIXTURES_DIR=../karum-infra/fixtures

# --- Cache -----------------------------------------------------------------
# Redis connection address. When empty, an in-process cache is used instead.
TASTE_REDIS_ADDR=localhost:6379
# Time-to-live for cached Qloo responses, in seconds (24h default).
TASTE_CACHE_TTL_SECONDS=86400
# Maximum parallel outbound Qloo calls per block-profile request.
TASTE_FANOUT_CAP=4

# --- Logging ---------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, or ERROR.
TASTE_LOG_LEVEL=INFO
